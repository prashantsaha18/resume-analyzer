DJANGO_SECRET_KEY=change-this-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL (or any PostgreSQL)
DB_NAME=neondb
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_HOST=your-project.us-east-2.aws.neon.tech
DB_PORT=5432

# Firebase (path to downloaded service account JSON)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Google Gemini AI (optional — app uses ML model if not set)
# Get free key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...

# Redis (optional — leave blank to disable Celery)
# REDIS_URL=redis://localhost:6379/0

# Frontend URL for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000