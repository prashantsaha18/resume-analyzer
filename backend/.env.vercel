# ── Copy these into Vercel Dashboard → Settings → Environment Variables ──────

DJANGO_SETTINGS_MODULE=resumeai.settings_vercel
DJANGO_SECRET_KEY=generate-a-strong-random-key-here

# Neon PostgreSQL
DB_NAME=neondb
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_HOST=your-project.us-east-2.aws.neon.tech
DB_PORT=5432

# Firebase
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optional — enables Gemini AI (without this, rule-based ML is used)
# GEMINI_API_KEY=AIzaSy...

# Your deployed frontend URL
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app